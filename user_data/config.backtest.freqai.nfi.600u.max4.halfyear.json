{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "max_open_trades": 4,
  "stake_currency": "USDT",
  "stake_amount": 150,
  "tradable_balance_ratio": 0.99,
  "fiat_display_currency": "USD",
  "dry_run": true,
  "dry_run_wallet": 600,
  "cancel_open_orders_on_exit": false,
  "trading_mode": "futures",
  "margin_mode": "isolated",
  "enable_protections": true,
  "unfilledtimeout": {
    "entry": 10,
    "exit": 10,
    "exit_timeout_count": 0,
    "unit": "minutes"
  },
  "entry_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1
  },
  "exit_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1
  },
  "exchange": {
    "name": "binance",
    "key": "",
    "secret": "",
    "ccxt_config": {
      "enableRateLimit": true,
      "options": {
        "adjustForTimeDifference": true,
        "recvWindow": 60000,
        "fetchMarkets": ["linear"]
      }
    },
    "ccxt_async_config": {
      "enableRateLimit": true,
      "options": {
        "adjustForTimeDifference": true,
        "recvWindow": 60000,
        "fetchMarkets": ["linear"]
      }
    },
    "pair_whitelist": [
      "BTC/USDT:USDT",
      "ETH/USDT:USDT",
      "APE/USDT:USDT",
      "SOL/USDT:USDT",
      "ZEC/USDT:USDT",
      "DOGE/USDT:USDT",
      "XRP/USDT:USDT",
      "GALA/USDT:USDT",
      "BNB/USDT:USDT",
      "ADA/USDT:USDT",
      "SUI/USDT:USDT",
      "AAVE/USDT:USDT",
      "AVAX/USDT:USDT",
      "LINK/USDT:USDT",
      "FIL/USDT:USDT",
      "TRX/USDT:USDT",
      "DOT/USDT:USDT",
      "NEAR/USDT:USDT",
      "DYDX/USDT:USDT",
      "BCH/USDT:USDT",
      "WLD/USDT:USDT",
      "LTC/USDT:USDT",
      "CRV/USDT:USDT",
      "ARB/USDT:USDT",
      "XLM/USDT:USDT",
      "XMR/USDT:USDT",
      "OP/USDT:USDT",
      "DASH/USDT:USDT",
      "APT/USDT:USDT"
    ],
    "pair_blacklist": [],
    "skip_pair_validation": true
  },
  "pairlists": [
    {"method": "StaticPairList"}
  ],
  "api_server": {
    "enabled": false,
    "listen_ip_address": "127.0.0.1",
    "listen_port": 8084,
    "username": "freqai",
    "password": "freqai"
  },
  "bot_name": "freqai-nfi-600u-max4-halfyear",
  "initial_state": "stopped",
  "internals": {
    "process_throttle_secs": 5
  },
  "reduce_df_footprint": true,
  "strategy": "NFIAIWrapperStrategy",
  "freqai": {
    "enabled": true,
    "train_period_days": 60,
    "backtest_period_days": 14,
    "live_retrain_hours": 4,
    "purge_old_models": 2,
    "identifier": "nfi-ai-wrapper-600u-max4",
    "feature_parameters": {
      "include_timeframes": ["5m", "1h", "4h"],
      "include_corr_pairlist": ["BTC/USDT:USDT", "ETH/USDT:USDT"],
      "include_shifted_candles": 2,
      "indicator_periods_candles": [10, 20, 40],
      "label_period_candles": 48,
      "DI_threshold": 0.85
    },
    "data_split_parameters": {
      "test_size": 0.25,
      "shuffle": false
    },
    "model_training_parameters": {
      "n_estimators": 200,
      "learning_rate": 0.05,
      "max_depth": 6,
      "num_leaves": 31,
      "min_child_weight": 5,
      "subsample": 0.8,
      "colsample_bytree": 0.8
    }
  }
}