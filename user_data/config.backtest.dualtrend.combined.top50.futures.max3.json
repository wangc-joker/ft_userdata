{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "max_open_trades": 3,
  "stake_currency": "USDT",
  "stake_amount": "unlimited",
  "tradable_balance_ratio": 0.99,
  "fiat_display_currency": "USD",
  "dry_run": true,
  "dry_run_wallet": 1000,
  "cancel_open_orders_on_exit": false,
  "trading_mode": "futures",
  "margin_mode": "isolated",
  "enable_protections": true,
  "unfilledtimeout": {
    "entry": 10,
    "exit": 10,
    "exit_timeout_count": 0,
    "unit": "minutes"
  },
  "entry_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1,
    "price_last_balance": 0.0,
    "check_depth_of_market": {
      "enabled": false,
      "bids_to_ask_delta": 1
    }
  },
  "exit_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1
  },
  "exchange": {
    "name": "binance",
    "key": "",
    "secret": "",
    "ccxt_config": {
      "enableRateLimit": true,
      "timeout": 60000,
      "options": {
        "adjustForTimeDifference": true,
        "recvWindow": 60000,
        "fetchCurrencies": false,
        "fetchMarkets": [
          "linear"
        ]
      }
    },
    "ccxt_async_config": {
      "enableRateLimit": true,
      "timeout": 60000,
      "options": {
        "adjustForTimeDifference": true,
        "recvWindow": 60000,
        "fetchCurrencies": false,
        "fetchMarkets": [
          "linear"
        ]
