  "api_server": {
    "enabled": false,
    "listen_ip_address": "127.0.0.1",
    "listen_port": 8084,
    "username": "nfi",
    "password": "nfi"
  },
  "bot_name": "nfi-baseline-600u-max4-halfyear",
  "initial_state": "stopped",
  "internals": {
    "process_throttle_secs": 5
  },
  "reduce_df_footprint": true,
  "strategy": "NostalgiaForInfinityX7"
}